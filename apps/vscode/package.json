{
  "name": "rachana-vscode",
  "displayName": "Rachana Designer — Visual Editor",
  "description": "Visual, drag-and-drop editor for HTML, Markdown and Astro. Style by clicking, save byte-preserving patches, and export to WordPress. Every feature unlocked.",
  "version": "1.0.0",
  "publisher": "rachana",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "html",
    "visual editor",
    "wysiwyg",
    "drag and drop",
    "css",
    "astro",
    "markdown",
    "wordpress"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "rachana.openVisualEditor",
        "title": "Open in Rachana Designer",
        "category": "Rachana",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .html || resourceExtname == .htm || resourceExtname == .astro || resourceExtname == .md || resourceExtname == .mdx",
          "command": "rachana.openVisualEditor",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == .html || resourceExtname == .htm || resourceExtname == .astro || resourceExtname == .md || resourceExtname == .mdx",
          "command": "rachana.openVisualEditor",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .html || resourceExtname == .htm || resourceExtname == .astro || resourceExtname == .md || resourceExtname == .mdx",
          "command": "rachana.openVisualEditor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Rachana Designer",
      "properties": {
        "rachana.styleMode": {
          "type": "string",
          "default": "class",
          "enum": ["class", "inline"],
          "enumDescriptions": [
            "Apply style changes to CSS classes",
            "Apply style changes as inline styles"
          ],
          "description": "How style changes are applied in the visual editor."
        },
        "rachana.styleScope": {
          "type": "string",
          "default": "local",
          "enum": ["local", "global"],
          "enumDescriptions": [
            "Save new CSS rules into a local <style> block in the current file",
            "Save new CSS rules into the project stylesheet"
          ],
          "description": "Where new CSS rules are saved when editing .astro files."
        },
        "rachana.globalCssPath": {
          "type": "string",
          "default": "src/styles/global.css",
          "description": "Path to the project stylesheet, relative to the workspace root."
        },
        "rachana.liveServerUrl": {
          "type": "string",
          "default": "",
          "description": "Origin of a running dev server for Live mode, for example http://localhost:4321. Leave empty to hide Live mode."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@rachana/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/vsce": "^3.2.1",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.4.11"
  }
}
