{
  "css": "/* ==================================================================\n * Cambodia Government Web Design System — global stylesheet\n *\n * Implements `design.md` (§66 custom properties, §3–§5 foundations and the\n * §18–§46 component specifications). Inlined into every sample page by\n * `scripts/build-sample-site.mjs` so each page is self-contained and works\n * when opened directly from disk, with no build step or server.\n *\n * Every value here is traceable to a section of design.md; where the spec is\n * silent, the conservative rule it recommends is used and noted.\n * ================================================================== */\n\n/* ------------------------------ tokens (§66) ---------------------- */\n\n:root {\n  /* Brand */\n  --gov-primary: #1c4076;\n  --gov-primary-dark: #003194;\n  --gov-primary-deep: #002266;\n  --gov-navy: #003a8a;\n  --gov-secondary: #3da3cf;\n  --gov-link: #0f71bb;\n  --gov-highlight: #f07d03;\n\n  /* Semantic */\n  --gov-success: #0a8217;\n  --gov-warning: #f79009;\n  --gov-danger: #d7260f;\n  --gov-info: #0f71bb;\n\n  /* Neutral */\n  --gov-white: #ffffff;\n  --gov-gray-100: #f7f7f9;\n  --gov-gray-200: #e4e7ec;\n  --gov-gray-300: #d0d5dd;\n  --gov-gray-400: #98a2b3;\n  --gov-gray-500: #667085;\n  --gov-gray-600: #344054;\n  --gov-gray-700: #1d2939;\n  --gov-surface-soft: #f4f6fa;\n  --gov-pale-blue: #ebf1ff;\n  --gov-danger-soft: #fff4f3;\n\n  /* Typography (§3.2) */\n  --gov-font-sans: \"Kantumruy Pro\", \"Open Sans\", ui-sans-serif, system-ui,\n    -apple-system, \"Segoe UI\", sans-serif;\n  --gov-text-sm: 0.875rem;\n  --gov-text-base: 1rem;\n  --gov-text-lg: 1.25rem;\n\n  --gov-h0: 3.5rem;\n  --gov-h1: 2.5rem;\n  --gov-h2: 2rem;\n  --gov-h3: 1.5rem;\n  --gov-h4: 1.125rem;\n  --gov-h5: 1rem;\n  --gov-h6: 1rem;\n\n  --gov-weight-light: 300;\n  --gov-weight-normal: 400;\n  --gov-weight-bold: 600;\n\n  --gov-leading-body: 2;\n  --gov-leading-sm: 1.75;\n  --gov-leading-lg: 2.25;\n  --gov-leading-heading: 1.2;\n\n  /* Spacing (§4) — 4px based */\n  --gov-space-1: 4px;\n  --gov-space-2: 8px;\n  --gov-space-3: 16px;\n  --gov-space-4: 24px;\n  --gov-space-5: 32px;\n  --gov-space-6: 40px;\n  --gov-space-7: 48px;\n  --gov-space-8: 56px;\n  --gov-space-9: 64px;\n  --gov-space-10: 80px;\n  --gov-space-11: 96px;\n  --gov-space-12: 128px;\n\n  /* Radius (§5.1) */\n  --gov-radius-xs: 4px;\n  --gov-radius-sm: 6px;\n  --gov-radius-md: 10px;\n  --gov-radius-lg: 12px;\n  --gov-radius-xl: 16px;\n  --gov-radius-pill: 999px;\n\n  /* Shadow (§5.3) */\n  --gov-shadow-xs: 0 1px 2px rgba(16, 24, 40, 0.05);\n  --gov-shadow-sm: 0 2px 8px rgba(16, 24, 40, 0.08);\n  --gov-shadow-md: 0 8px 20px rgba(16, 24, 40, 0.1);\n\n  /* Layout (§6.2) */\n  --gov-container: 1320px;\n  --gov-wrapper: 1440px;\n  --gov-reading: 760px;\n\n  /* NOT SPECIFIED in design.md (§8 gap 1): the spec defines no z-index scale.\n     These are the conservative values the document's components imply. */\n  --gov-z-header: 100;\n  --gov-z-dropdown: 200;\n  --gov-z-modal: 300;\n  --gov-z-toast: 400;\n}\n\n/* ------------------------------ reset ---------------------------- */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  -webkit-text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  font-family: var(--gov-font-sans);\n  font-size: var(--gov-text-base);\n  font-weight: var(--gov-weight-normal);\n  /* Khmer body text needs 1.8–2 (§3.2). Never crop glyphs with a fixed line box. */\n  line-height: var(--gov-leading-body);\n  color: var(--gov-gray-700);\n  background: var(--gov-white);\n  -webkit-font-smoothing: antialiased;\n}\n\n/* §18/§72: never remove focus states. §56 focus ring. */\n:focus-visible {\n  outline: 3px solid rgba(15, 113, 187, 0.45);\n  outline-offset: 2px;\n}\n\n/* §69: no horizontal overflow at 320px. */\nimg,\nsvg,\nvideo,\niframe {\n  max-width: 100%;\n}\n\nimg {\n  height: auto;\n}\n\n/* --------------------------- primitives -------------------------- */\n\n/* §6.2 global container */\n.gov-container {\n  width: min(100% - 32px, var(--gov-container));\n  margin-inline: auto;\n}\n\n.gov-wrapper {\n  max-width: var(--gov-wrapper);\n  margin-inline: auto;\n}\n\n/* §77 skip link — required but visually hidden until focused. */\n.gov-skip-link {\n  position: absolute;\n  left: -9999px;\n  top: 0;\n  z-index: var(--gov-z-toast);\n  background: var(--gov-primary);\n  color: #fff;\n  padding: 12px 20px;\n  border-radius: 0 0 var(--gov-radius-sm) 0;\n  text-decoration: none;\n  font-weight: var(--gov-weight-bold);\n}\n\n.gov-skip-link:focus {\n  left: 0;\n}\n\n/* §6.1 collapse point for the mobile navigation. */\n.gov-visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* §4 section rhythm */\n.gov-section {\n  padding-block: 48px;\n}\n\n.gov-section--editorial {\n  padding-block: 64px 80px;\n}\n\n.gov-section--subtle {\n  background: var(--gov-gray-100);\n}\n\n.gov-section--soft {\n  background: var(--gov-surface-soft);\n}\n\n.gov-section--pale {\n  background: var(--gov-pale-blue);\n}\n\n.gov-section--primary {\n  background: var(--gov-primary);\n  color: #fff;\n}\n\n@media (max-width: 767px) {\n  .gov-section,\n  .gov-section--editorial {\n    padding-block: 24px 32px;\n  }\n}\n\n/* §17 Section header pattern */\n.gov-section-heading {\n  margin-bottom: 24px;\n}\n\n.gov-section-heading__eyebrow {\n  margin: 0 0 4px;\n  font-size: var(--gov-text-sm);\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.6;\n  color: var(--gov-primary);\n}\n\n.gov-section-heading__title {\n  margin: 0;\n  font-size: var(--gov-h2);\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.35;\n  color: var(--gov-gray-700);\n}\n\n.gov-section-heading__description {\n  margin: 8px 0 0;\n  color: var(--gov-gray-600);\n  max-width: var(--gov-reading);\n}\n\n.gov-section-heading--with-action {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 16px;\n}\n\n/* §3.2 headings — 56/40/32/24/18/16/16 */\nh1,\nh2,\nh3,\nh4,\nh5,\nh6 {\n  margin: 0 0 8px;\n  font-weight: var(--gov-weight-bold);\n  line-height: var(--gov-leading-heading);\n  color: var(--gov-gray-700);\n}\n\n.gov-h0 {\n  font-size: var(--gov-h0);\n}\nh1 {\n  font-size: var(--gov-h1);\n}\nh2 {\n  font-size: var(--gov-h2);\n}\nh3 {\n  font-size: var(--gov-h3);\n}\nh4 {\n  font-size: var(--gov-h4);\n}\nh5,\nh6 {\n  font-size: var(--gov-h5);\n}\n\np {\n  margin: 0 0 16px;\n}\n\n/* §19 links */\na {\n  color: var(--gov-link);\n  text-decoration-thickness: from-font;\n  text-underline-offset: 2px;\n}\n\na:hover {\n  color: var(--gov-highlight);\n}\n\n.gov-link-standalone {\n  font-weight: var(--gov-weight-bold);\n}\n\n/* §3.2 metadata */\n.gov-meta {\n  font-size: var(--gov-text-sm);\n  line-height: 1.6;\n  color: var(--gov-gray-500);\n}\n\n.gov-eyebrow {\n  font-size: var(--gov-text-sm);\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.6;\n  color: var(--gov-primary);\n}\n\n/* §5.2 borders / §5.3 elevation */\n.gov-card {\n  background: var(--gov-white);\n  border: 1px solid var(--gov-gray-200);\n  border-radius: var(--gov-radius-md);\n  padding: var(--gov-space-4);\n}\n\n.gov-card--soft {\n  background: var(--gov-surface-soft);\n  border: 0;\n}\n\n.gov-divider {\n  border: 0;\n  border-top: 1px solid var(--gov-gray-200);\n  margin: 0;\n}\n\n/* --------------------------- §8 trust bar ------------------------ */\n\n.gov-trust-bar {\n  background: var(--gov-gray-100);\n  color: var(--gov-gray-600);\n  font-size: var(--gov-text-sm);\n  border-bottom: 1px solid var(--gov-gray-200);\n  min-height: 36px;\n}\n\n.gov-trust-bar__inner {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding-block: 6px;\n}\n\n.gov-trust-bar__message {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0;\n}\n\n.gov-trust-bar svg {\n  flex-shrink: 0;\n  color: var(--gov-primary);\n}\n\n.gov-trust-bar a {\n  color: var(--gov-primary);\n  font-weight: var(--gov-weight-bold);\n  /* §8: tap targets at least 44px, including on mobile. */\n  display: inline-flex;\n  align-items: center;\n  min-height: 44px;\n}\n\n/* ------------------------- §9/§80 header ------------------------- */\n\n.gov-header {\n  background: var(--gov-white);\n  border-bottom: 1px solid var(--gov-gray-200);\n}\n\n.gov-header__identity {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  padding-block: 16px;\n  min-height: 80px;\n}\n\n.gov-agency {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  text-decoration: none;\n  color: inherit;\n}\n\n.gov-agency__emblem {\n  width: 56px;\n  height: 56px;\n  flex-shrink: 0;\n  border-radius: var(--gov-radius-xs);\n  background: var(--gov-primary);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  font-weight: var(--gov-weight-bold);\n  font-size: 18px;\n  /* §9: preserve clear space; never distort the emblem. */\n}\n\n.gov-agency__text {\n  display: flex;\n  flex-direction: column;\n}\n\n.gov-agency__name {\n  /* §9: 18–24px / 600 / 1.5; Khmer names must wrap naturally. */\n  font-size: 20px;\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.5;\n  color: var(--gov-primary);\n}\n\n.gov-agency__sub {\n  font-size: var(--gov-text-sm);\n  color: var(--gov-gray-500);\n  line-height: 1.6;\n}\n\n.gov-header__utilities {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-shrink: 0;\n}\n\n/* §11 search */\n.gov-search {\n  display: flex;\n  width: 374px;\n  max-width: 100%;\n}\n\n.gov-search input {\n  flex: 1;\n  height: 44px;\n  padding: 8px 12px;\n  border: 1px solid var(--gov-gray-300);\n  border-right: 0;\n  border-radius: var(--gov-radius-sm) 0 0 var(--gov-radius-sm);\n  background: var(--gov-white);\n  color: var(--gov-gray-700);\n  font: inherit;\n  font-size: var(--gov-text-base);\n}\n\n.gov-search input:focus {\n  border-color: var(--gov-primary);\n  outline: 3px solid rgba(28, 64, 118, 0.18);\n  outline-offset: 1px;\n}\n\n.gov-search button {\n  width: 44px;\n  height: 44px;\n  border: 0;\n  border-radius: 0 var(--gov-radius-sm) var(--gov-radius-sm) 0;\n  background: var(--gov-primary);\n  color: #fff;\n  cursor: pointer;\n  display: grid;\n  place-items: center;\n}\n\n/* §12 language switcher — country markers are never the sole indicator. */\n.gov-lang {\n  display: inline-flex;\n  align-items: center;\n  min-width: 85px;\n  height: 44px;\n  justify-content: center;\n  gap: 6px;\n  border: 1px solid var(--gov-gray-300);\n  border-radius: var(--gov-radius-md);\n  background: var(--gov-white);\n  color: var(--gov-gray-700);\n  font-size: var(--gov-text-sm);\n  text-decoration: none;\n  padding-inline: 12px;\n}\n\n.gov-lang:hover {\n  border-color: var(--gov-primary);\n  color: var(--gov-primary);\n}\n\n/* ------------------------ §10 primary nav ------------------------ */\n\n.gov-nav {\n  background: var(--gov-primary);\n}\n\n.gov-nav__list {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: stretch;\n  gap: 5px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.gov-nav__link {\n  /* §10 */\n  display: flex;\n  align-items: center;\n  padding: 11px 23px;\n  min-height: 48px;\n  color: #fff;\n  font-weight: var(--gov-weight-normal);\n  text-decoration: none;\n  border-bottom: 3px solid transparent;\n}\n\n.gov-nav__link:hover {\n  background: var(--gov-primary-dark);\n  color: #fff;\n}\n\n/* §10: current page must not rely on colour alone — weight + border + aria-current. */\n.gov-nav__link[aria-current=\"page\"] {\n  font-weight: var(--gov-weight-bold);\n  background: var(--gov-primary-deep);\n  border-bottom-color: var(--gov-highlight);\n}\n\n.gov-nav__toggle {\n  display: none;\n  align-items: center;\n  gap: 8px;\n  min-height: 44px;\n  padding: 8px 14px;\n  border: 1px solid var(--gov-gray-300);\n  border-radius: var(--gov-radius-md);\n  background: var(--gov-white);\n  color: var(--gov-gray-700);\n  font: inherit;\n  font-weight: var(--gov-weight-bold);\n  cursor: pointer;\n}\n\n/* §10/§80: collapse into a drawer below 992px. */\n@media (max-width: 991px) {\n  .gov-header__identity {\n    flex-wrap: wrap;\n  }\n  .gov-nav__toggle {\n    display: inline-flex;\n  }\n  .gov-nav__list {\n    display: none;\n    flex-direction: column;\n    gap: 0;\n  }\n  .gov-nav__list[data-open=\"true\"] {\n    display: flex;\n  }\n  .gov-nav__link {\n    border-bottom: 1px solid var(--gov-primary-dark);\n    border-left: 3px solid transparent;\n  }\n  .gov-nav__link[aria-current=\"page\"] {\n    border-bottom-color: var(--gov-primary-dark);\n    border-left-color: var(--gov-highlight);\n  }\n  .gov-search {\n    width: 100%;\n    margin-block: 10px;\n  }\n}\n\n/* §13 breadcrumbs — wrap rather than scroll. */\n.gov-breadcrumbs {\n  font-size: var(--gov-text-sm);\n  color: var(--gov-gray-500);\n  padding-block: 16px;\n}\n\n.gov-breadcrumbs ol {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.gov-breadcrumbs li + li::before {\n  content: \"/\";\n  margin-right: 8px;\n  color: var(--gov-gray-400);\n}\n\n.gov-breadcrumbs a {\n  color: var(--gov-link);\n}\n\n.gov-breadcrumbs [aria-current=\"page\"] {\n  color: var(--gov-gray-600);\n}\n\n/* --------------------------- §15 hero --------------------------- */\n\n.gov-hero {\n  position: relative;\n  background: var(--gov-primary-deep);\n  color: #fff;\n  overflow: hidden;\n}\n\n.gov-hero__media {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* §15 overlay — only to guarantee contrast, never for style alone. */\n.gov-hero__overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    90deg,\n    rgba(0, 34, 102, 0.85) 0%,\n    rgba(0, 34, 102, 0.45) 45%,\n    rgba(0, 34, 102, 0) 75%\n  );\n}\n\n.gov-hero__inner {\n  position: relative;\n  display: grid;\n  grid-template-columns: 0.4fr 0.6fr;\n  gap: 40px;\n  align-items: center;\n  padding-block: 64px;\n  min-height: 380px;\n}\n\n.gov-hero__title {\n  /* §15 */\n  font-size: clamp(32px, 3.5vw, 56px);\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.3;\n  color: #fff;\n  margin: 0 0 12px;\n}\n\n.gov-hero__text {\n  color: rgba(255, 255, 255, 0.9);\n  max-width: 46ch;\n  margin-bottom: 24px;\n}\n\n@media (max-width: 991px) {\n  .gov-hero__inner {\n    grid-template-columns: 1fr;\n    padding-block: 40px;\n  }\n  .gov-hero__title {\n    font-size: 32px;\n  }\n}\n\n/* §15 slide indicators */\n.gov-hero__dots {\n  position: relative;\n  display: flex;\n  gap: 10px;\n  padding-bottom: 24px;\n  list-style: none;\n  margin: 0;\n}\n\n.gov-hero__dot {\n  width: 12px;\n  height: 12px;\n  border-radius: var(--gov-radius-pill);\n  border: 2px solid #fff;\n  background: transparent;\n  padding: 0;\n  cursor: pointer;\n}\n\n.gov-hero__dot[aria-current=\"true\"] {\n  background: #fff;\n}\n\n/* --------------------------- §18 buttons ------------------------- */\n\n.gov-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  /* §18 */\n  min-height: 44px;\n  padding: 10px 16px;\n  border-radius: var(--gov-radius-md);\n  font-family: inherit;\n  font-size: var(--gov-text-base);\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.4;\n  text-decoration: none;\n  cursor: pointer;\n  border: 1px solid transparent;\n  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;\n}\n\n.gov-btn--primary {\n  background: var(--gov-primary);\n  border-color: var(--gov-primary);\n  color: #fff;\n}\n\n.gov-btn--primary:hover {\n  background: var(--gov-primary-dark);\n  border-color: var(--gov-primary-dark);\n  color: #fff;\n}\n\n.gov-btn--primary:active {\n  background: var(--gov-primary-deep);\n  border-color: var(--gov-primary-deep);\n}\n\n.gov-btn--outline {\n  background: var(--gov-white);\n  border-color: var(--gov-primary);\n  color: var(--gov-primary);\n}\n\n.gov-btn--outline:hover {\n  background: var(--gov-pale-blue);\n  color: var(--gov-primary);\n}\n\n.gov-btn--on-primary {\n  background: var(--gov-white);\n  border-color: var(--gov-white);\n  color: var(--gov-primary);\n}\n\n.gov-btn--on-primary:hover {\n  background: var(--gov-pale-blue);\n  border-color: var(--gov-pale-blue);\n  color: var(--gov-primary-deep);\n}\n\n/* §18 link button for low-priority actions. */\n.gov-btn--link {\n  background: transparent;\n  border-color: transparent;\n  color: var(--gov-link);\n  padding-inline: 4px;\n}\n\n.gov-btn--link:hover {\n  color: var(--gov-highlight);\n}\n\n.gov-btn--danger {\n  background: var(--gov-danger);\n  border-color: var(--gov-danger);\n  color: #fff;\n}\n\n/* §18: disabled must not rely on opacity alone — pair it with a muted surface. */\n.gov-btn[disabled],\n.gov-btn[aria-disabled=\"true\"] {\n  background: var(--gov-gray-200);\n  border-color: var(--gov-gray-200);\n  color: var(--gov-gray-500);\n  cursor: not-allowed;\n  opacity: 1;\n}\n\n/* §18: buttons may go full-width on phones for primary workflows. */\n@media (max-width: 575px) {\n  .gov-btn--block-sm {\n    width: 100%;\n  }\n}\n\n/* --------------------------- §20 cards -------------------------- */\n\n.gov-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));\n  gap: 16px;\n}\n\n@media (min-width: 768px) {\n  .gov-grid {\n    gap: 24px;\n  }\n}\n\n@media (min-width: 1200px) {\n  .gov-grid--editorial {\n    gap: 32px;\n  }\n}\n\n/* §20.3 action card */\n.gov-action-card {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  background: var(--gov-white);\n  border: 1px solid var(--gov-gray-200);\n  border-radius: var(--gov-radius-md);\n  padding: var(--gov-space-4);\n  text-decoration: none;\n  color: inherit;\n  transition: box-shadow 160ms ease, border-color 160ms ease, background-color 160ms ease;\n}\n\n.gov-action-card:hover {\n  border-color: var(--gov-gray-300);\n  box-shadow: var(--gov-shadow-sm);\n  color: inherit;\n}\n\n.gov-action-card__title {\n  margin: 0;\n  font-size: var(--gov-h4);\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.4;\n  color: var(--gov-gray-700);\n}\n\n.gov-action-card__text {\n  margin: 0;\n  color: var(--gov-gray-600);\n  line-height: var(--gov-leading-sm);\n}\n\n/* §21 public service card */\n.gov-service-card__icon {\n  width: 48px;\n  height: 48px;\n  border-radius: var(--gov-radius-md);\n  background: var(--gov-pale-blue);\n  color: var(--gov-primary);\n  display: grid;\n  place-items: center;\n  margin-bottom: 12px;\n}\n\n.gov-service-card__action {\n  margin-top: auto;\n  padding-top: 12px;\n  font-weight: var(--gov-weight-bold);\n  color: var(--gov-primary);\n}\n\n/* §22 news card */\n.gov-news-card {\n  display: flex;\n  flex-direction: column;\n  background: var(--gov-white);\n  border: 1px solid var(--gov-gray-200);\n  border-radius: var(--gov-radius-md);\n  overflow: hidden;\n  text-decoration: none;\n  color: inherit;\n  transition: box-shadow 160ms ease, border-color 160ms ease;\n}\n\n.gov-news-card:hover {\n  box-shadow: var(--gov-shadow-sm);\n  border-color: var(--gov-gray-300);\n  color: inherit;\n}\n\n.gov-news-card__image {\n  aspect-ratio: 16 / 9;\n  width: 100%;\n  object-fit: cover;\n  display: block;\n  background: var(--gov-gray-100);\n}\n\n.gov-news-card__body {\n  padding: var(--gov-space-4);\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  flex: 1;\n}\n\n.gov-news-card__meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 10px;\n  font-size: var(--gov-text-sm);\n}\n\n.gov-news-card__category {\n  font-weight: var(--gov-weight-bold);\n  color: var(--gov-primary);\n}\n\n.gov-news-card__date {\n  color: var(--gov-gray-500);\n}\n\n.gov-news-card__title {\n  margin: 0;\n  /* §22: 18–20px / 600 / 1.5. Khmer titles may need taller cards — no clamp. */\n  font-size: 19px;\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.5;\n  color: var(--gov-gray-700);\n}\n\n.gov-news-card__excerpt {\n  margin: 0;\n  color: var(--gov-gray-600);\n  line-height: var(--gov-leading-sm);\n}\n\n/* §26 logo grid */\n.gov-logo-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 16px;\n}\n\n@media (min-width: 768px) {\n  .gov-logo-grid {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media (min-width: 992px) {\n  .gov-logo-grid {\n    grid-template-columns: repeat(4, 1fr);\n  }\n}\n\n@media (min-width: 1200px) {\n  .gov-logo-grid {\n    grid-template-columns: repeat(6, 1fr);\n  }\n}\n\n.gov-logo-card {\n  background: var(--gov-white);\n  border: 1px solid var(--gov-gray-200);\n  border-radius: var(--gov-radius-sm);\n  min-height: 112px;\n  padding: 20px;\n  display: grid;\n  place-items: center;\n  text-align: center;\n  text-decoration: none;\n  color: var(--gov-gray-600);\n  font-size: var(--gov-text-sm);\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.5;\n}\n\n.gov-logo-card:hover {\n  border-color: var(--gov-primary);\n  color: var(--gov-primary);\n}\n\n/* §23 statistics */\n.gov-stats {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));\n  gap: 24px;\n}\n\n.gov-stat {\n  /* §23: dividers/whitespace, not heavy card borders. */\n  padding-left: 24px;\n  border-left: 2px solid var(--gov-gray-200);\n}\n\n.gov-stat__value {\n  font-size: clamp(32px, 4vw, 48px);\n  font-weight: var(--gov-weight-bold);\n  line-height: 1.2;\n  color: var(--gov-primary);\n}\n\n.gov-stat__label {\n  font-size: 15px;\n  line-height: 1.7;\n  color: var(--gov-gray-600);\n}\n\n.gov-stat__note {\n  font-size: var(--gov-text-sm);\n  color: var(--gov-gray-500);\n  line-height: 1.6;\n}\n\n/* §24 FAQ accordion */\n.gov-accordion {\n  border-top: 1px solid var(--gov-gray-200);\n}\n\n.gov-accordion__item {\n  border-bottom: 1px solid var(--gov-gray-200);\n}\n\n.gov-accordion__trigger {\n  width: 100%;\n  padding: 16px 0;\n  background: transparent;\n  border: 0;\n  color: var(--gov-gray-700);\n  font: inherit;\n  font-weight: var(--gov-weight-bold);\n  text-align: left;\n  cursor: pointer;\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n}\n\n.gov-accordion__item[open] > .gov-accordion__trigger,\n.gov-accordion__trigger[aria-expanded=\"true\"] {\n  background: rgba(28, 64, 118, 0.05);\n}\n\n.gov-accordion__panel {\n  padding: 0 0 20px;\n  color: var(--gov-gray-600);\n  max-width: var(--gov-reading);\n}\n\n/* §25 CTA band */\n.gov-cta {\n  background: var(--gov-primary);\n  color: #fff;\n  border-radius: var(--gov-radius-lg);\n  padding: 40px 48px;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n}\n\n.gov-cta--subtle {\n  background: var(--gov-pale-blue);\n  color: var(--gov-gray-700);\n}\n\n.gov-cta__title {\n  color: inherit;\n  margin: 0 0 8px;\n}\n\n.gov-cta__text {\n  margin: 0;\n  color: inherit;\n  opacity: 0.92;\n  max-width: 62ch;\n}\n\n@media (max-width: 767px) {\n  .gov-cta {\n    padding: 24px;\n  }\n}\n\n/* §28 about split */\n.gov-split {\n  display: grid;\n  grid-template-columns: 1.15fr 1fr;\n  gap: 40px;\n  align-items: center;\n}\n\n.gov-split--reverse {\n  grid-template-columns: 1fr 1.15fr;\n}\n\n@media (max-width: 991px) {\n  .gov-split,\n  .gov-split--reverse {\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n}\n\n.gov-split__media img {\n  width: 100%;\n  border-radius: var(--gov-radius-md);\n  display: block;\n}\n\n/* §16 leadership message */\n.gov-leadership {\n  display: grid;\n  grid-template-columns: 0.4fr 0.6fr;\n  gap: 40px;\n  align-items: start;\n}\n\n.gov-leadership__portrait img {\n  width: 100%;\n  aspect-ratio: 4 / 5;\n  object-fit: cover;\n  border-radius: var(--gov-radius-md);\n  display: block;\n}\n\n.gov-leadership__signature {\n  margin-top: 16px;\n  padding-top: 12px;\n  border-top: 1px solid var(--gov-gray-200);\n}\n\n.gov-leadership__name {\n  font-weight: var(--gov-weight-bold);\n  color: var(--gov-gray-700);\n  margin: 0;\n}\n\n.gov-leadership__role {\n  font-size: var(--gov-text-sm);\n  color: var(--gov-gray-500);\n  margin: 0;\n}\n\n@media (max-width: 991px) {\n  .gov-leadership {\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n}\n\n/* §29 contact + map */\n.gov-contact-split {\n  display: grid;\n  grid-template-columns: 0.4fr 0.6fr;\n  gap: 32px;\n  align-items: start;\n}\n\n@media (max-width: 991px) {\n  .gov-contact-split {\n    grid-template-columns: 1fr;\n  }\n}\n\n.gov-contact-list {\n  margin: 0;\n  display: grid;\n  gap: 16px;\n}\n\n.gov-contact-list dt {\n  font-size: var(--gov-text-sm);\n  font-weight: var(--gov-weight-bold);\n  color: var(--gov-gray-500);\n}\n\n.gov-contact-list dd {\n  margin: 4px 0 0;\n  color: var(--gov-gray-700);\n}\n\n.gov-map {\n  aspect-ratio: 16 / 9;\n  min-height: 320px;\n  border-radius: var(--gov-radius-md);\n  overflow: hidden;\n  border: 1px solid var(--gov-gray-200);\n  background: var(--gov-gray-100);\n  display: grid;\n  place-items: center;\n  text-align: center;\n  padding: 24px;\n  color: var(--gov-gray-600);\n}\n\n/* ---------------------------- §30 footer ------------------------ */\n\n.gov-footer {\n  background: var(--gov-primary);\n  color: #fff;\n  padding-top: 48px;\n  padding-bottom: 24px;\n}\n\n.gov-footer__grid {\n  display: grid;\n  grid-template-columns: 1.4fr 1fr 1fr 1fr;\n  gap: 32px;\n}\n\n@media (max-width: 991px) {\n  .gov-footer__grid {\n    grid-template-columns: 1fr 1fr;\n    gap: 24px;\n  }\n}\n\n@media (max-width: 575px) {\n  .gov-footer__grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.gov-footer__heading {\n  color: #fff;\n  font-size: var(--gov-text-base);\n  font-weight: var(--gov-weight-bold);\n  margin: 0 0 12px;\n}\n\n.gov-footer ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.gov-footer li {\n  line-height: var(--gov-leading-body);\n}\n\n.gov-footer a {\n  /* §30 */\n  color: var(--gov-gray-300);\n  text-decoration: none;\n}\n\n.gov-footer a:hover,\n.gov-footer a:focus {\n  color: var(--gov-highlight);\n  text-decoration: underline;\n}\n\n.gov-footer__bottom {\n  margin-top: 32px;\n  padding-top: 16px;\n  border-top: 1px solid rgba(255, 255, 255, 0.2);\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  font-size: var(--gov-text-sm);\n  color: var(--gov-gray-300);\n}\n\n/* ---------------------------- §31 forms ------------------------- */\n\n.gov-form {\n  display: grid;\n  gap: 20px;\n  max-width: 640px;\n}\n\n.gov-field {\n  display: grid;\n  gap: 8px;\n}\n\n.gov-field__label {\n  font-size: var(--gov-text-base);\n  font-weight: var(--gov-weight-bold);\n  color: var(--gov-gray-700);\n}\n\n.gov-field__required {\n  color: var(--gov-danger);\n}\n\n.gov-field input,\n.gov-field select,\n.gov-field textarea {\n  min-height: 44px;\n  padding: 8px 12px;\n  border: 1px solid var(--gov-gray-400);\n  border-radius: var(--gov-radius-sm);\n  background: var(--gov-white);\n  color: var(--gov-gray-700);\n  font: inherit;\n  font-size: var(--gov-text-base);\n  width: 100%;\n}\n\n.gov-field textarea {\n  min-height: 120px;\n  resize: vertical;\n}\n\n.gov-field input:focus,\n.gov-field select:focus,\n.gov-field textarea:focus {\n  border-color: var(--gov-primary);\n  outline: 3px solid rgba(28, 64, 118, 0.18);\n  outline-offset: 1px;\n}\n\n.gov-field__help {\n  font-size: var(--gov-text-sm);\n  color: var(--gov-gray-500);\n  margin: 0;\n}\n\n.gov-field__error {\n  font-size: var(--gov-text-sm);\n  font-weight: var(--gov-weight-bold);\n  color: var(--gov-danger);\n  margin: 0;\n}\n\n.gov-field--error input,\n.gov-field--error textarea,\n.gov-field--error select {\n  border-color: var(--gov-danger);\n}\n\n/* §32 checkbox / radio — native semantics, generous label target. */\n.gov-check {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  min-height: 44px;\n  padding-block: 8px;\n  cursor: pointer;\n}\n\n.gov-check input {\n  width: 20px;\n  height: 20px;\n  margin: 2px 0 0;\n  flex-shrink: 0;\n}\n\n/* §33 file upload */\n.gov-file {\n  border: 1px dashed var(--gov-gray-300);\n  border-radius: var(--gov-radius-md);\n  padding: 20px;\n  background: var(--gov-gray-100);\n  display: grid;\n  gap: 8px;\n}\n\n/* ---------------------------- §34 alerts ------------------------ */\n\n.gov-alert {\n  display: flex;\n  gap: 12px;\n  padding: 16px;\n  border-radius: var(--gov-radius-sm);\n  border-left: 4px solid var(--gov-info);\n  background: var(--gov-pale-blue);\n  color: var(--gov-gray-700);\n}\n\n.gov-alert__title {\n  margin: 0 0 4px;\n  font-weight: var(--gov-weight-bold);\n}\n\n.gov-alert__text {\n  margin: 0;\n}\n\n.gov-alert--success {\n  border-left-color: var(--gov-success);\n  background: #f1faf2;\n}\n\n.gov-alert--warning {\n  border-left-color: var(--gov-warning);\n  background: #fff8ec;\n}\n\n.gov-alert--danger {\n  border-left-color: var(--gov-danger);\n  background: var(--gov-danger-soft);\n}\n\n/* --------------------------- §35 badges ------------------------- */\n\n.gov-badge {\n  display: inline-flex;\n  align-items: center;\n  min-height: 24px;\n  padding-inline: 8px;\n  border-radius: var(--gov-radius-pill);\n  font-size: 13px;\n  font-weight: var(--gov-weight-bold);\n  background: var(--gov-gray-200);\n  color: var(--gov-gray-700);\n  white-space: nowrap;\n}\n\n.gov-badge--online,\n.gov-badge--success {\n  background: #e8f6ea;\n  color: #075c10;\n}\n\n.gov-badge--new,\n.gov-badge--info {\n  background: var(--gov-pale-blue);\n  color: var(--gov-primary-deep);\n}\n\n.gov-badge--closed,\n.gov-badge--danger {\n  background: var(--gov-danger-soft);\n  color: #96200c;\n}\n\n/* --------------------------- §36 tables ------------------------- */\n\n.gov-table-wrap {\n  overflow-x: auto;\n  -webkit-overflow-scrolling: touch;\n}\n\n.gov-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 15px;\n}\n\n.gov-table caption {\n  text-align: left;\n  font-weight: var(--gov-weight-bold);\n  padding-bottom: 12px;\n  color: var(--gov-gray-700);\n}\n\n.gov-table th,\n.gov-table td {\n  padding: 12px 16px;\n  text-align: left;\n  border-bottom: 1px solid var(--gov-gray-200);\n  vertical-align: top;\n}\n\n.gov-table th {\n  background: var(--gov-gray-100);\n  font-weight: var(--gov-weight-bold);\n  color: var(--gov-gray-700);\n}\n\n/* -------------------------- §37 pagination ---------------------- */\n\n.gov-pagination {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px;\n  padding: 0;\n  margin: 32px 0 0;\n  list-style: none;\n}\n\n.gov-pagination a,\n.gov-pagination span {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 44px;\n  min-height: 44px;\n  padding-inline: 12px;\n  border: 1px solid var(--gov-gray-300);\n  border-radius: var(--gov-radius-sm);\n  color: var(--gov-gray-700);\n  text-decoration: none;\n  font-weight: var(--gov-weight-bold);\n}\n\n.gov-pagination a:hover {\n  border-color: var(--gov-primary);\n  color: var(--gov-primary);\n}\n\n.gov-pagination [aria-current=\"page\"] {\n  background: var(--gov-primary);\n  border-color: var(--gov-primary);\n  color: #fff;\n}\n\n/* ------------------- §38 documents / downloads ------------------ */\n\n.gov-doc-list {\n  display: grid;\n  gap: 0;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  border-top: 1px solid var(--gov-gray-200);\n}\n\n.gov-doc {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 16px;\n  padding: 16px 0;\n  border-bottom: 1px solid var(--gov-gray-200);\n}\n\n.gov-doc__icon {\n  width: 40px;\n  height: 40px;\n  flex-shrink: 0;\n  border-radius: var(--gov-radius-sm);\n  background: var(--gov-danger-soft);\n  color: var(--gov-danger);\n  display: grid;\n  place-items: center;\n  font-size: 11px;\n  font-weight: var(--gov-weight-bold);\n}\n\n.gov-doc__body {\n  flex: 1;\n  min-width: 200px;\n}\n\n.gov-doc__title {\n  margin: 0;\n  font-weight: var(--gov-weight-bold);\n  color: var(--gov-gray-700);\n}\n\n.gov-doc__meta {\n  font-size: var(--gov-text-sm);\n  color: var(--gov-gray-500);\n  margin: 2px 0 0;\n}\n\n/* §39 filter chips */\n.gov-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin: 0 0 24px;\n  padding: 0;\n  list-style: none;\n}\n\n.gov-chip {\n  display: inline-flex;\n  align-items: center;\n  min-height: 40px;\n  padding-inline: 16px;\n  border: 1px solid var(--gov-gray-300);\n  border-radius: var(--gov-radius-pill);\n  background: var(--gov-white);\n  color: var(--gov-gray-700);\n  text-decoration: none;\n  font-size: var(--gov-text-sm);\n  font-weight: var(--gov-weight-bold);\n}\n\n.gov-chip:hover {\n  border-color: var(--gov-primary);\n  color: var(--gov-primary);\n}\n\n.gov-chip[aria-current=\"true\"] {\n  background: var(--gov-primary);\n  border-color: var(--gov-primary);\n  color: #fff;\n}\n\n/* §48 side navigation */\n.gov-with-sidebar {\n  display: grid;\n  grid-template-columns: 280px 1fr;\n  gap: 40px;\n  align-items: start;\n}\n\n@media (max-width: 991px) {\n  .gov-with-sidebar {\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n}\n\n.gov-side-nav {\n  position: sticky;\n  top: 24px;\n  border: 1px solid var(--gov-gray-200);\n  border-radius: var(--gov-radius-md);\n  padding: 16px;\n}\n\n.gov-side-nav ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.gov-side-nav a {\n  display: block;\n  padding: 10px 12px;\n  border-radius: var(--gov-radius-sm);\n  color: var(--gov-gray-700);\n  text-decoration: none;\n}\n\n.gov-side-nav a:hover {\n  background: var(--gov-gray-100);\n  color: var(--gov-primary);\n}\n\n.gov-side-nav [aria-current=\"page\"] {\n  background: var(--gov-pale-blue);\n  color: var(--gov-primary);\n  font-weight: var(--gov-weight-bold);\n}\n\n@media (max-width: 991px) {\n  .gov-side-nav {\n    position: static;\n  }\n}\n\n/* §40 service detail: in-page contents */\n.gov-toc {\n  border-left: 3px solid var(--gov-gray-200);\n  padding-left: 16px;\n  margin-bottom: 32px;\n}\n\n.gov-toc ul {\n  list-style: none;\n  margin: 8px 0 0;\n  padding: 0;\n}\n\n.gov-toc a {\n  display: block;\n  padding: 6px 0;\n  color: var(--gov-link);\n}\n\n/* §51 stepper */\n.gov-stepper {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n  margin: 0 0 32px;\n  padding: 0;\n  list-style: none;\n  counter-reset: gov-step;\n}\n\n.gov-stepper li {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--gov-gray-500);\n  font-weight: var(--gov-weight-bold);\n}\n\n.gov-stepper li::before {\n  counter-increment: gov-step;\n  content: counter(gov-step);\n  width: 32px;\n  height: 32px;\n  border-radius: var(--gov-radius-pill);\n  background: var(--gov-gray-200);\n  color: var(--gov-gray-600);\n  display: grid;\n  place-items: center;\n  font-size: var(--gov-text-sm);\n  flex-shrink: 0;\n}\n\n.gov-stepper li[aria-current=\"step\"] {\n  color: var(--gov-primary);\n}\n\n.gov-stepper li[aria-current=\"step\"]::before {\n  background: var(--gov-primary);\n  color: #fff;\n}\n\n/* §63 empty / loading / error states */\n.gov-state {\n  text-align: center;\n  padding: 48px 24px;\n  border: 1px dashed var(--gov-gray-300);\n  border-radius: var(--gov-radius-md);\n  background: var(--gov-gray-100);\n}\n\n.gov-state__title {\n  margin: 0 0 8px;\n  font-size: var(--gov-h4);\n  font-weight: var(--gov-weight-bold);\n}\n\n.gov-state__text {\n  margin: 0 0 20px;\n  color: var(--gov-gray-600);\n}\n\n/* §64 404 */\n.gov-error-code {\n  font-size: 72px;\n  font-weight: var(--gov-weight-bold);\n  line-height: 1;\n  color: var(--gov-primary);\n  margin: 0 0 8px;\n}\n\n/* §57/§59 utility: readable measure for long-form content. */\n.gov-reading {\n  max-width: var(--gov-reading);\n}\n\n/* §55 motion: respect the user's preference. */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n\n/* §65 print: preserve content, drop chrome. */\n@media print {\n  .gov-trust-bar,\n  .gov-nav,\n  .gov-header__utilities,\n  .gov-pagination,\n  .gov-cta,\n  .gov-side-nav,\n  .gov-skip-link {\n    display: none !important;\n  }\n\n  body {\n    color: #000;\n    background: #fff;\n  }\n\n  .gov-footer {\n    background: #fff;\n    color: #000;\n    border-top: 1px solid #000;\n  }\n\n  .gov-footer a {\n    color: #000;\n  }\n\n  a[href^=\"http\"]::after {\n    content: \" (\" attr(href) \")\";\n    font-size: 12px;\n  }\n\n  h1,\n  h2,\n  h3 {\n    break-after: avoid;\n  }\n}\n"
}
