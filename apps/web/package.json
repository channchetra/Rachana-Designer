{
  "name": "@rachana/web",
  "private": true,
  "version": "1.0.0",
  "description": "Rachana Designer web app — browser-hosted visual editor with File System Access API project folders.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:samples": "node scripts/sync-gov-css.mjs && node scripts/build-sample-site.mjs",
    "sync:samples-css": "node scripts/sync-gov-css.mjs",
    "clean": "node ../../scripts/clean-emitted-js.mjs",
    "clean:check": "node ../../scripts/clean-emitted-js.mjs --check"
  },
  "dependencies": {
    "@astrojs/compiler": "^2.13.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.42.1",
    "@rachana/core": "*",
    "@uiw/react-codemirror": "^4.25.9",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.575.0",
    "marked": "^17.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "turndown": "^7.2.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
